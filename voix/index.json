[{"key":"chatte-1-1","text":"ذَهَبَ زَيْدُونُ إِلَى الْحَدِيقَةِ."},{"key":"chatte-2-1","text":"رَأَى قِطَّةً صَغِيرَةً."},{"key":"chatte-3-1","text":"الْقِطَّةُ جَائِعَةٌ."},{"key":"chatte-4-1","text":"أَعْطَى زَيْدُونُ الْقِطَّةَ حَلِيبًا."},{"key":"chatte-5-1","text":"شَرِبَتِ الْقِطَّةُ الْحَلِيبَ وَفَرِحَتْ."},{"key":"pomme-1-1","text":"مَعَ زَيْدُونَ تُفَّاحَةٌ حَمْرَاءُ."},{"key":"pomme-2-1","text":"جَاءَ صَدِيقُهُ عَلِيٌّ."},{"key":"pomme-3-1","text":"عَلِيٌّ جَائِعٌ."},{"key":"pomme-4-1","text":"قَسَمَ زَيْدُونُ التُّفَّاحَةَ نِصْفَيْنِ."},{"key":"pomme-5-1","text":"أَكَلَ الصَّدِيقَانِ وَضَحِكَا."},{"key":"joha-lune-1-1","text":"فِي لَيْلَةٍ ذَهَبَ جُحَا إِلَى الْبِئْرِ."},{"key":"joha-lune-2-1","text":"نَظَرَ فِي الْبِئْرِ فَرَأَى الْقَمَرَ."},{"key":"joha-lune-3-1","text":"قَالَ جُحَا: «سَقَطَ الْقَمَرُ فِي الْبِئْرِ!»"},{"key":"joha-lune-4-1","text":"رَمَى حَبْلًا لِيُخْرِجَهُ."},{"key":"joha-lune-5-1","text":"شَدَّ الْحَبْلَ بِقُوَّةٍ فَسَقَطَ عَلَى ظَهْرِهِ."},{"key":"joha-lune-6-1","text":"رَأَى الْقَمَرَ فِي السَّمَاءِ فَقَالَ:"},{"key":"joha-lune-6-2","text":"«الْحَمْدُ لِلَّهِ، أَنْقَذْتُ الْقَمَرَ!»"},{"key":"corbeau-1-1","text":"كَانَ الْغُرَابُ عَطْشَانَ."},{"key":"corbeau-2-1","text":"رَأَى جَرَّةً فِيهَا قَلِيلٌ مِنَ الْمَاءِ."},{"key":"corbeau-3-1","text":"لَمْ يَصِلْ مِنْقَارُهُ إِلَى الْمَاءِ."},{"key":"corbeau-4-1","text":"فَكَّرَ الْغُرَابُ ثُمَّ جَمَعَ حِجَارَةً صَغِيرَةً."},{"key":"corbeau-5-1","text":"أَلْقَى الْحِجَارَةَ فِي الْجَرَّةِ فَارْتَفَعَ الْمَاءُ."},{"key":"corbeau-6-1","text":"شَرِبَ الْغُرَابُ وَطَارَ سَعِيدًا."},{"key":"fourmi-1-1","text":"كَانَتْ نَمْلَةٌ تَمْشِي مَعَ أَخَوَاتِهَا."},{"key":"fourmi-2-1","text":"جَاءَ جَيْشُ سُلَيْمَانَ عَلَيْهِ السَّلَامُ."},{"key":"fourmi-3-1","text":"قَالَتِ النَّمْلَةُ:"},{"key":"fourmi-3-2","text":"«يَا أَيُّهَا النَّمْلُ ادْخُلُوا مَسَاكِنَكُمْ»"},{"key":"fourmi-4-1","text":"سَمِعَ سُلَيْمَانُ كَلَامَهَا فَتَبَسَّمَ."},{"key":"fourmi-5-1","text":"شَكَرَ سُلَيْمَانُ اللَّهَ عَلَى نِعَمِهِ."},{"key":"joha-ane-1-1","text":"خَرَجَ جُحَا وَابْنُهُ إِلَى السُّوقِ مَعَ حِمَارِهِمَا."},{"key":"joha-ane-2-1","text":"رَكِبَ جُحَا الْحِمَارَ وَمَشَى ابْنُهُ."},{"key":"joha-ane-2-2","text":"قَالَ النَّاسُ: «الْأَبُ لَا يَرْحَمُ ابْنَهُ!»"},{"key":"joha-ane-3-1","text":"نَزَلَ جُحَا وَرَكِبَ ابْنُهُ."},{"key":"joha-ane-3-2","text":"قَالَ النَّاسُ: «الِابْنُ لَا يَحْتَرِمُ أَبَاهُ!»"},{"key":"joha-ane-4-1","text":"رَكِبَا مَعًا عَلَى الْحِمَارِ."},{"key":"joha-ane-4-2","text":"قَالَ النَّاسُ: «مِسْكِينٌ هَذَا الْحِمَارُ!»"},{"key":"joha-ane-5-1","text":"نَزَلَا وَمَشَيَا خَلْفَ الْحِمَارِ."},{"key":"joha-ane-5-2","text":"قَالَ النَّاسُ: «يَمْشِيَانِ وَمَعَهُمَا حِمَارٌ!»"},{"key":"joha-ane-6-1","text":"حَمَلَا الْحِمَارَ عَلَى أَكْتَافِهِمَا."},{"key":"joha-ane-6-2","text":"ضَحِكَ النَّاسُ كَثِيرًا."},{"key":"joha-ane-7-1","text":"قَالَ جُحَا لِابْنِهِ:"},{"key":"joha-ane-7-2","text":"«رِضَا النَّاسِ غَايَةٌ لَا تُدْرَكُ.»"},{"key":"joha-ane-8-1","text":"«افْعَلْ مَا تَرَاهُ صَوَابًا يَا بُنَيَّ.»"},{"key":"lion-lievre-1-1","text":"كَانَ فِي الْغَابَةِ أَسَدٌ قَوِيٌّ."},{"key":"lion-lievre-2-1","text":"كَانَ الْأَسَدُ يَأْكُلُ الْحَيَوَانَاتِ كُلَّ يَوْمٍ."},{"key":"lion-lievre-3-1","text":"اتَّفَقَتِ الْحَيَوَانَاتُ"},{"key":"lion-lievre-3-2","text":"أَنْ تُرْسِلَ لَهُ حَيَوَانًا وَاحِدًا كُلَّ يَوْمٍ."},{"key":"lion-lievre-4-1","text":"جَاءَ دَوْرُ الْأَرْنَبِ."},{"key":"lion-lievre-4-2","text":"تَأَخَّرَ الْأَرْنَبُ قَلِيلًا."},{"key":"lion-lievre-5-1","text":"غَضِبَ الْأَسَدُ وَسَأَلَ:"},{"key":"lion-lievre-5-2","text":"«لِمَاذَا تَأَخَّرْتَ؟»"},{"key":"lion-lievre-6-1","text":"قَالَ الْأَرْنَبُ: «فِي الطَّرِيقِ أَسَدٌ آخَرُ،"},{"key":"lion-lievre-6-2","text":"قَالَ إِنَّهُ مَلِكُ الْغَابَةِ!»"},{"key":"lion-lievre-7-1","text":"قَالَ الْأَسَدُ: «خُذْنِي إِلَيْهِ!»"},{"key":"lion-lievre-8-1","text":"أَخَذَهُ الْأَرْنَبُ إِلَى بِئْرٍ عَمِيقَةٍ."},{"key":"lion-lievre-8-2","text":"قَالَ: «هُوَ هُنَا!»"},{"key":"lion-lievre-9-1","text":"نَظَرَ الْأَسَدُ فِي الْبِئْرِ"},{"key":"lion-lievre-9-2","text":"فَرَأَى صُورَتَهُ فِي الْمَاءِ."},{"key":"lion-lievre-10-1","text":"قَفَزَ الْأَسَدُ فِي الْبِئْرِ،"},{"key":"lion-lievre-10-2","text":"وَنَجَتِ الْحَيَوَانَاتُ بِذَكَاءِ الْأَرْنَبِ."},{"key":"icare-1-1","text":"فِي جَزِيرَةٍ بَعِيدَةٍ عَاشَ مُخْتَرِعٌ اسْمُهُ دِيدَالُوسُ."},{"key":"icare-1-2","text":"كَانَ مَعَهُ ابْنُهُ إِيكَارُوسُ."},{"key":"icare-2-1","text":"حَبَسَهُمَا الْمَلِكُ فِي بُرْجٍ عَالٍ."},{"key":"icare-3-1","text":"جَمَعَ الْأَبُ الرِّيشَ وَالشَّمْعَ"},{"key":"icare-3-2","text":"وَصَنَعَ أَجْنِحَةً."},{"key":"icare-4-1","text":"قَالَ الْأَبُ: «لَا تَقْتَرِبْ مِنَ الشَّمْسِ،"},{"key":"icare-4-2","text":"فَالشَّمْعُ يَذُوبُ!»"},{"key":"icare-5-1","text":"طَارَ الْأَبُ وَالِابْنُ فَوْقَ الْبَحْرِ."},{"key":"icare-6-1","text":"فَرِحَ إِيكَارُوسُ وَطَارَ عَالِيًا… عَالِيًا…"},{"key":"icare-7-1","text":"اقْتَرَبَ مِنَ الشَّمْسِ فَذَابَ الشَّمْعُ"},{"key":"icare-7-2","text":"وَتَطَايَرَ الرِّيشُ."},{"key":"icare-8-1","text":"سَقَطَ إِيكَارُوسُ فِي الْبَحْرِ."},{"key":"icare-8-2","text":"الدَّرْسُ: اسْمَعْ نَصِيحَةَ وَالِدَيْكَ."},{"key":"sindbad-1-1","text":"كَانَ السِّنْدِبَادُ تَاجِرًا يَعِيشُ فِي بَغْدَادَ."},{"key":"sindbad-2-1","text":"أَحَبَّ السِّنْدِبَادُ السَّفَرَ وَالْمُغَامَرَاتِ."},{"key":"sindbad-3-1","text":"رَكِبَ سَفِينَةً كَبِيرَةً مَعَ تُجَّارٍ آخَرِينَ."},{"key":"sindbad-4-1","text":"أَبْحَرَتِ السَّفِينَةُ أَيَّامًا وَلَيَالِيَ."},{"key":"sindbad-5-1","text":"رَأَوْا جَزِيرَةً خَضْرَاءَ جَمِيلَةً."},{"key":"sindbad-6-1","text":"نَزَلُوا عَلَى الْجَزِيرَةِ"},{"key":"sindbad-6-2","text":"وَأَشْعَلُوا نَارًا لِلطَّبْخِ."},{"key":"sindbad-7-1","text":"فَجْأَةً… تَحَرَّكَتِ الْجَزِيرَةُ!"},{"key":"sindbad-8-1","text":"لَمْ تَكُنْ جَزِيرَةً…"},{"key":"sindbad-8-2","text":"كَانَتْ سَمَكَةً عِمْلَاقَةً!"},{"key":"sindbad-9-1","text":"غَاصَتِ السَّمَكَةُ فِي الْبَحْرِ،"},{"key":"sindbad-9-2","text":"وَسَقَطَ السِّنْدِبَادُ فِي الْمَاءِ."},{"key":"sindbad-10-1","text":"تَمَسَّكَ بِقِطْعَةِ خَشَبٍ"},{"key":"sindbad-10-2","text":"وَسَبَحَ طَوَالَ اللَّيْلِ."},{"key":"sindbad-11-1","text":"فِي الصَّبَاحِ وَصَلَ إِلَى جَزِيرَةٍ حَقِيقِيَّةٍ."},{"key":"sindbad-12-1","text":"وَجَدَ فِيهَا خُيُولًا جَمِيلَةً"},{"key":"sindbad-12-2","text":"وَمَلِكًا طَيِّبًا."},{"key":"sindbad-13-1","text":"سَاعَدَهُ الْمَلِكُ،"},{"key":"sindbad-13-2","text":"وَرَكِبَ سَفِينَةً إِلَى بَغْدَادَ."},{"key":"sindbad-14-1","text":"رَجَعَ السِّنْدِبَادُ إِلَى بَيْتِهِ،"},{"key":"sindbad-14-2","text":"وَحَكَى قِصَّتَهُ لِأَصْدِقَائِهِ."},{"key":"mot-1","text":"أَسَد"},{"key":"mot-2","text":"بَاب"},{"key":"mot-3","text":"سَمَك"},{"key":"mot-4","text":"نَار"},{"key":"mot-5","text":"جَمَل"},{"key":"mot-6","text":"فِيل"},{"key":"mot-7","text":"بَيْت"},{"key":"mot-8","text":"قَمَر"},{"key":"mot-9","text":"شَمْس"},{"key":"mot-10","text":"عَسَل"},{"key":"mot-11","text":"وَرْدَة"},{"key":"mot-12","text":"دُبّ"},{"key":"mot-13","text":"يَد"},{"key":"mot-14","text":"عَيْن"},{"key":"mot-15","text":"قَلَم"},{"key":"mot-16","text":"عِنَب"},{"key":"mot-17","text":"كَلْب"},{"key":"mot-18","text":"دِيك"},{"key":"mot-19","text":"شَجَرَة"},{"key":"mot-20","text":"حِصَان"},{"key":"mot-21","text":"تُفَّاح"},{"key":"mot-22","text":"مَوْز"},{"key":"mot-23","text":"حُوت"},{"key":"mot-24","text":"بَحْر"},{"key":"mot-25","text":"كِتَاب"},{"key":"mot-26","text":"سَيَّارَة"},{"key":"mot-27","text":"طَائِرَة"},{"key":"mot-28","text":"سُلَحْفَاة"},{"key":"mot-29","text":"فَرَاشَة"},{"key":"mot-30","text":"أَرْنَب"},{"key":"mot-31","text":"قِطَّة"},{"key":"mot-32","text":"حَلِيب"},{"key":"mot-33","text":"مَاء"},{"key":"mot-34","text":"خُبْز"},{"key":"mot-35","text":"نَجْمَة"},{"key":"mot-36","text":"مَطَر"},{"key":"mot-37","text":"مَدْرَسَة"},{"key":"mot-38","text":"مِفْتَاح"},{"key":"mot-39","text":"مَسْجِد"},{"key":"mot-40","text":"بُرْتُقَال"},{"key":"mot-41","text":"زَرَافَة"},{"key":"mot-42","text":"قِرْد"},{"key":"mot-43","text":"ثَعْلَب"},{"key":"mot-44","text":"ضِفْدَع"},{"key":"mot-45","text":"بِطِّيخ"},{"key":"mot-46","text":"جُبْن"},{"key":"mot-47","text":"سَاعَة"},{"key":"mot-48","text":"زَهْرَة"},{"key":"mot-49","text":"خَرُوف"},{"key":"mot-50","text":"حِذَاء"},{"key":"mot-51","text":"غَيْمَة"},{"key":"mot-52","text":"لَيْمُون"},{"key":"mot-53","text":"نَسْر"},{"key":"mot-54","text":"نَحْلَة"},{"key":"mot-55","text":"نَمْلَة"},{"key":"mot-56","text":"جَبَل"},{"key":"mot-57","text":"ظَرْف"},{"key":"mot-58","text":"صُنْدُوق"},{"key":"mot-59","text":"طَاوُوس"},{"key":"mot-60","text":"ذِئْب"},{"key":"mot-61","text":"غَزَال"},{"key":"mot-62","text":"بَقَرَة"},{"key":"mot-63","text":"بَيْضَة"},{"key":"mot-64","text":"طَمَاطِم"}]